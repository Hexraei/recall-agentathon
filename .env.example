# ---------------------------------------------------------------------------
# Copy to .env and fill in. ONLY the first line is required to run the kit.
# Everything else is an upgrade you can add later without touching code.
# ---------------------------------------------------------------------------

# Groq is the primary provider. Free tier, and an order of magnitude faster
# than the shared OpenRouter pool on this workload - measured, not assumed:
# 0.89s against 15-20s on the same extraction prompt, 3/3 parsed both ways.
# Get one free at console.groq.com. Leave blank and everything falls back to
# OpenRouter exactly as the kit shipped.
GROQ_API_KEY=

# The capped key handed out at the registration desk. $10 start, one top-up
# to +$5 max (docs/agentic-slice-kit/docs/ON-THE-DAY.md). Now the FALLBACK,
# not the primary - measured slower than Groq at every model tried, but it is
# a real second provider, which is what a fallback is for.
OPENROUTER_API_KEY=

# Chosen by measuring, not by reading a pricing page. bakeoff.py runs the real
# extraction prompt against a real submission and scores three things: did it
# parse, how long did it take, and did every passage it quoted actually appear
# in the source. That last one decides it - a model that paraphrases produces
# fluent evidence the citation check then demotes, and extraction yields
# nothing supported.
#
# 3 trials each on Groq, 18 Sep 2026:
#   qwen/qwen3.8-27b       0.89s   3/3 parsed, every passage verbatim  <- chosen
#   openai/gpt-oss-20b     1.67s   3/3
#   openai/gpt-oss-120b    2.35s   3/3
#
# PINNED VERSION: never a ":batch" variant (not callable via /chat/completions)
# and never a "~...latest" alias - a judge re-running your demo must get the
# same behaviour.
SLICE_MODEL=qwen/qwen3.8-27b

# Availability insurance - a genuinely different provider, not just a
# different model on the same one. Any model id NOT in GROQ_MODELS
# (slice/llm.py) routes to OpenRouter automatically, so this is a real
# fallback: if Groq has an outage, the run degrades to OpenRouter rather than
# failing entirely.
#
# Benchmarked against Groq on the same extraction prompt, paid key, 19 Sep:
#   mistralai/mistral-small-3.2-24b-instruct   4.0s   3/3 parsed, verbatim
#   anthropic/claude-haiku-4.5                 5.9s   3/3 parsed, verbatim
#   qwen/qwen3.8-27b (same weights as primary) 68.6s  2/3 - OpenRouter's own
#                                               routing hop, not the model
#   inclusionai/ling-3.0-flash (kit's default) --     0/3 - failed to parse
#
# Do NOT put a Groq-served id here (e.g. openai/gpt-oss-20b) - GROQ_MODELS
# would route it straight back to Groq, giving no real redundancy despite
# looking like a different model.
SLICE_FALLBACK_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Rejected, and why - so nobody helpfully "optimises" these back in:
#   qwen/qwen3.7-flash   cheap, 1M context, and unusable. Unparseable output on
#                        one run, HTTP 429 on the next. Two runs, two failures.
#   z-ai/glm-5.3-flash   NOT actually rejected on merit - see below. It failed
#                        our eval because it is verbose (~890 tokens) and the
#                        eval capped output at 700, cutting it off mid-JSON.
#                        Correct behaviour, wrong parameter. Re-test it before
#                        ruling it out; it may be the better choice.
#   openai/gpt-oss-120b  perfect but ~11.5s per call. In a gate loop that
#                        revises three times, that is a demo which feels hung.

SLICE_ESCALATION_MODEL=anthropic/claude-haiku-4.5

# OPTIONAL - free tier, 1B tokens/month. If set, cheap calls route here first.
# Needs phone verification and a data-training opt-in: do not put anything
# confidential through this key.
MISTRAL_API_KEY=

# OPTIONAL - tracing. If these are blank the tracer no-ops and nothing breaks.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Budgets. These are the fences. Lower them, never raise them casually.
SLICE_MAX_TOKENS_PER_RUN=250000
# Per-request output ceiling, and it pulls in two directions.
#   Too HIGH: OpenRouter reserves against max_tokens, so requests start failing
#             with HTTP 402 while you still have usable credit.
#   Too LOW:  a verbose model is cut off mid-JSON. llm.py raises Truncated and
#             tells you so, rather than letting it look like a prompt problem -
#             we lost time to exactly that mistake.
# 1200 suits a terse default model. Raise it if you see Truncated.
SLICE_MAX_TOKENS=1200
SLICE_MAX_ATTEMPTS_PER_STEP=3
SLICE_EXPERT_TIMEOUT_MINUTES=45
